import React, { useState, useEffect } from 'react';
import { ShieldCheck, X, Plus, Trash2, Users, Calendar, BarChart3, Download, Search, Check, Lock, Building, Mail, MapPin } from 'lucide-react';
import { EventItem, FacultyMember, StudentRegistration, Department } from '../types';

interface AdminPanelProps {
  isOpen: boolean;
  onClose: () => void;
  events: EventItem[];
  facultyList: FacultyMember[];
  onRefreshData: () => void;
}

export const AdminPanel: React.FC<AdminPanelProps> = ({
  isOpen,
  onClose,
  events,
  facultyList,
  onRefreshData,
}) => {
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [loginError, setLoginError] = useState('');
  const [activeAdminTab, setActiveAdminTab] = useState<'events' | 'faculty' | 'registrations' | 'analytics'>('analytics');

  // Form states for adding new Event
  const [newEvent, setNewEvent] = useState({
    title: '',
    date: '2026-08-15',
    time: '10:00 AM - 01:00 PM',
    venue: 'Saranathan Main Auditorium',
    category: 'Technical' as const,
    description: '',
    organizer: 'Department of CSE & SaraCode',
    capacity: 200,
  });

  // Form states for adding new Faculty
  const [newFaculty, setNewFaculty] = useState({
    name: '',
    designation: 'Assistant Professor',
    department: 'CSE' as Department,
    email: '',
    office: 'Room 202, CSE Block',
    qualification: 'M.E., Ph.D.',
    experience: '8+ Years',
  });

  const [registrations, setRegistrations] = useState<StudentRegistration[]>([]);
  const [regSearch, setRegSearch] = useState('');

  useEffect(() => {
    if (isOpen && isAuthenticated) {
      fetchRegistrations();
    }
  }, [isOpen, isAuthenticated]);

  const fetchRegistrations = async () => {
    try {
      const res = await fetch('/api/registrations');
      const data = await res.json();
      setRegistrations(data);
    } catch (err) {
      console.error('Failed to fetch registrations:', err);
    }
  };

  if (!isOpen) return null;

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoginError('');

    try {
      const res = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password }),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Login failed');
      }

      setIsAuthenticated(true);
    } catch (err: any) {
      setLoginError(err.message || 'Invalid credentials');
    }
  };

  const handleAddEvent = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newEvent.title.trim()) return;

    try {
      const res = await fetch('/api/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(newEvent),
      });

      if (res.ok) {
        setNewEvent({
          title: '',
          date: '2026-08-15',
          time: '10:00 AM - 01:00 PM',
          venue: 'Saranathan Main Auditorium',
          category: 'Technical',
          description: '',
          organizer: 'Department of CSE & SaraCode',
          capacity: 200,
        });
        onRefreshData();
      }
    } catch (err) {
      console.error('Failed to add event:', err);
    }
  };

  const handleDeleteEvent = async (id: string) => {
    if (!confirm('Are you sure you want to delete this event?')) return;
    try {
      await fetch(`/api/events/${id}`, { method: 'DELETE' });
      onRefreshData();
    } catch (err) {
      console.error('Failed to delete event:', err);
    }
  };

  const handleAddFaculty = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newFaculty.name.trim()) return;

    try {
      const res = await fetch('/api/faculty', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(newFaculty),
      });

      if (res.ok) {
        setNewFaculty({
          name: '',
          designation: 'Assistant Professor',
          department: 'CSE',
          email: '',
          office: 'Room 202, CSE Block',
          qualification: 'M.E., Ph.D.',
          experience: '8+ Years',
        });
        onRefreshData();
      }
    } catch (err) {
      console.error('Failed to add faculty:', err);
    }
  };

  const handleDeleteFaculty = async (id: string) => {
    if (!confirm('Are you sure you want to delete this faculty member?')) return;
    try {
      await fetch(`/api/faculty/${id}`, { method: 'DELETE' });
      onRefreshData();
    } catch (err) {
      console.error('Failed to delete faculty:', err);
    }
  };

  const exportRegistrationsCSV = () => {
    const headers = ['Pass ID', 'Name', 'Register No', 'Department', 'Year', 'Email', 'Phone', 'Event Title', 'Timestamp'];
    const rows = registrations.map(r => [
      r.id,
      `"${r.name}"`,
      r.registerNo,
      r.department,
      r.year,
      r.email,
      r.phone,
      `"${r.eventTitle}"`,
      r.timestamp
    ]);

    const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement('a');
    link.setAttribute('href', encodedUri);
    link.setAttribute('download', `Saranathan_Student_Registrations_${Date.now()}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const filteredRegs = registrations.filter(r =>
    r.name.toLowerCase().includes(regSearch.toLowerCase()) ||
    r.registerNo.toLowerCase().includes(regSearch.toLowerCase()) ||
    r.eventTitle.toLowerCase().includes(regSearch.toLowerCase()) ||
    r.department.toLowerCase().includes(regSearch.toLowerCase())
  );

  return (
    <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-lg flex items-center justify-center p-4 overflow-y-auto">
      <div className="glass-card rounded-3xl max-w-4xl w-full border border-emerald-500/30 shadow-2xl overflow-hidden my-8">
        
        {/* Modal Header */}
        <div className="p-6 bg-slate-900 border-b border-slate-800 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-600 flex items-center justify-center text-white shadow-md">
              <ShieldCheck className="w-5 h-5" />
            </div>
            <div>
              <h3 className="font-heading font-extrabold text-lg text-white">
                SaraConnect Admin Command Center
              </h3>
              <p className="text-xs text-slate-400">
                Manage Events, Faculty Members, Registrations & Analytics
              </p>
            </div>
          </div>

          <button
            onClick={onClose}
            className="w-8 h-8 rounded-full bg-slate-800 text-slate-300 hover:text-rose-400 hover:bg-slate-700 flex items-center justify-center transition-colors cursor-pointer"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Modal Body */}
        {!isAuthenticated ? (
          /* Login Form */
          <div className="p-8 max-w-md mx-auto text-center">
            <div className="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mx-auto mb-4 border border-emerald-500/20">
              <Lock className="w-6 h-6" />
            </div>

            <h4 className="font-heading font-bold text-xl text-slate-900 dark:text-white mb-6">
              Secure Admin Sign In
            </h4>

            {loginError && (
              <div className="mb-4 p-3 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-500 text-xs font-semibold">
                {loginError}
              </div>
            )}

            <form onSubmit={handleLogin} className="space-y-4 text-left">
              <div>
                <label className="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                  Username
                </label>
                <input
                  type="text"
                  required
                  value={username}
                  onChange={(e) => setUsername(e.target.value)}
                  className="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-emerald-500"
                />
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                  Password
                </label>
                <input
                  type="password"
                  required
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  className="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-emerald-500"
                />
              </div>

              <button
                type="submit"
                className="w-full py-3 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-500 shadow-lg shadow-emerald-600/30 transition-all cursor-pointer"
              >
                Sign In to Admin Portal
              </button>
            </form>
          </div>
        ) : (
          /* Authenticated Admin Workspace */
          <div>
            {/* Admin Tabs Bar */}
            <div className="flex border-b border-slate-200 dark:border-slate-800 bg-slate-950/40 px-6 pt-3 gap-2 overflow-x-auto">
              {[
                { id: 'analytics', label: 'Dashboard Stats', icon: BarChart3 },
                { id: 'events', label: 'Manage Events', icon: Calendar },
                { id: 'faculty', label: 'Faculty Directory', icon: Users },
                { id: 'registrations', label: 'Registered Students', icon: ShieldCheck },
              ].map((tab) => {
                const Icon = tab.icon;
                const isActive = activeAdminTab === tab.id;
                return (
                  <button
                    key={tab.id}
                    onClick={() => setActiveAdminTab(tab.id as any)}
                    className={`px-4 py-2.5 rounded-t-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer border-t border-x ${
                      isActive
                        ? 'bg-slate-900 text-emerald-400 border-emerald-500/30'
                        : 'text-slate-400 hover:text-white border-transparent'
                    }`}
                  >
                    <Icon className="w-3.5 h-3.5" />
                    <span>{tab.label}</span>
                  </button>
                );
              })}
            </div>

            {/* Tab Contents */}
            <div className="p-6 max-h-[500px] overflow-y-auto">
              
              {/* Analytics Tab */}
              {activeAdminTab === 'analytics' && (
                <div className="space-y-6">
                  <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div className="p-5 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
                      <div className="text-3xl font-extrabold">{events.length}</div>
                      <div className="text-xs font-semibold text-slate-300 mt-1">Total Active Events</div>
                    </div>

                    <div className="p-5 rounded-2xl bg-teal-500/10 border border-teal-500/30 text-teal-400">
                      <div className="text-3xl font-extrabold">{facultyList.length}</div>
                      <div className="text-xs font-semibold text-slate-300 mt-1">Faculty Members</div>
                    </div>

                    <div className="p-5 rounded-2xl bg-green-500/10 border border-green-500/30 text-green-400">
                      <div className="text-3xl font-extrabold">{registrations.length}</div>
                      <div className="text-xs font-semibold text-slate-300 mt-1">Student Registrations</div>
                    </div>
                  </div>

                  <div className="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-3">
                    <h4 className="font-heading font-bold text-sm text-white">Top Events Registration Progress</h4>
                    {events.map((e) => (
                      <div key={e.id} className="space-y-1">
                        <div className="flex justify-between text-xs text-slate-300">
                          <span>{e.title}</span>
                          <span className="font-bold text-emerald-400">{e.registeredCount} / {e.capacity}</span>
                        </div>
                        <div className="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                          <div
                            className="bg-emerald-500 h-full rounded-full transition-all duration-500"
                            style={{ width: `${Math.min(100, Math.round((e.registeredCount / e.capacity) * 100))}%` }}
                          />
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Events Management Tab */}
              {activeAdminTab === 'events' && (
                <div className="space-y-6">
                  {/* Add Event Form */}
                  <form onSubmit={handleAddEvent} className="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-3">
                    <h4 className="font-heading font-bold text-sm text-white flex items-center gap-2">
                      <Plus className="w-4 h-4 text-emerald-400" />
                      Add New Campus Event
                    </h4>

                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <input
                        type="text"
                        placeholder="Event Title"
                        required
                        value={newEvent.title}
                        onChange={(e) => setNewEvent({ ...newEvent, title: e.target.value })}
                        className="px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-emerald-500"
                      />
                      <input
                        type="date"
                        value={newEvent.date}
                        onChange={(e) => setNewEvent({ ...newEvent, date: e.target.value })}
                        className="px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-emerald-500"
                      />
                    </div>

                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <input
                        type="text"
                        placeholder="Time (e.g. 10:00 AM - 01:00 PM)"
                        value={newEvent.time}
                        onChange={(e) => setNewEvent({ ...newEvent, time: e.target.value })}
                        className="px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-emerald-500"
                      />
                      <input
                        type="text"
                        placeholder="Venue"
                        value={newEvent.venue}
                        onChange={(e) => setNewEvent({ ...newEvent, venue: e.target.value })}
                        className="px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-emerald-500"
                      />
                    </div>

                    <textarea
                      placeholder="Event Description..."
                      rows={2}
                      value={newEvent.description}
                      onChange={(e) => setNewEvent({ ...newEvent, description: e.target.value })}
                      className="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-emerald-500"
                    />

                    <button
                      type="submit"
                      className="px-4 py-2 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 transition-colors cursor-pointer"
                    >
                      Publish Event
                    </button>
                  </form>

                  {/* Existing Events List */}
                  <div className="space-y-2">
                    <h4 className="font-heading font-bold text-xs text-slate-400 uppercase tracking-wider">Active Published Events</h4>
                    {events.map((e) => (
                      <div key={e.id} className="p-3 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-3 text-xs">
                        <div>
                          <div className="font-bold text-white">{e.title} ({e.date})</div>
                          <div className="text-slate-400">{e.venue} • {e.registeredCount} registered</div>
                        </div>
                        <button
                          onClick={() => handleDeleteEvent(e.id)}
                          className="p-2 rounded-lg text-rose-400 hover:bg-rose-500/10 transition-colors cursor-pointer"
                          title="Delete Event"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Faculty Directory Tab */}
              {activeAdminTab === 'faculty' && (
                <div className="space-y-6">
                  {/* Add Faculty Form */}
                  <form onSubmit={handleAddFaculty} className="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-3">
                    <h4 className="font-heading font-bold text-sm text-white flex items-center gap-2">
                      <Plus className="w-4 h-4 text-emerald-400" />
                      Add Faculty Member
                    </h4>

                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <input
                        type="text"
                        placeholder="Faculty Full Name"
                        required
                        value={newFaculty.name}
                        onChange={(e) => setNewFaculty({ ...newFaculty, name: e.target.value })}
                        className="px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-emerald-500"
                      />
                      <input
                        type="email"
                        placeholder="Email (e.g., professor@saranathan.ac.in)"
                        value={newFaculty.email}
                        onChange={(e) => setNewFaculty({ ...newFaculty, email: e.target.value })}
                        className="px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-emerald-500"
                      />
                    </div>

                    <button
                      type="submit"
                      className="px-4 py-2 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 transition-colors cursor-pointer"
                    >
                      Add Faculty
                    </button>
                  </form>

                  {/* Existing Faculty List */}
                  <div className="space-y-2">
                    <h4 className="font-heading font-bold text-xs text-slate-400 uppercase tracking-wider">Faculty List</h4>
                    {facultyList.map((f) => (
                      <div key={f.id} className="p-3 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between gap-3 text-xs">
                        <div>
                          <div className="font-bold text-white">{f.name} ({f.department})</div>
                          <div className="text-slate-400">{f.designation} • {f.email}</div>
                        </div>
                        <button
                          onClick={() => handleDeleteFaculty(f.id)}
                          className="p-2 rounded-lg text-rose-400 hover:bg-rose-500/10 transition-colors cursor-pointer"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Student Registrations Table Tab */}
              {activeAdminTab === 'registrations' && (
                <div className="space-y-4">
                  <div className="flex flex-col sm:flex-row items-center justify-between gap-3">
                    <div className="relative w-full sm:w-64">
                      <Search className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" />
                      <input
                        type="text"
                        placeholder="Search student or pass ID..."
                        value={regSearch}
                        onChange={(e) => setRegSearch(e.target.value)}
                        className="w-full pl-9 pr-3 py-1.5 rounded-xl bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none focus:border-emerald-500"
                      />
                    </div>

                    <button
                      onClick={exportRegistrationsCSV}
                      className="w-full sm:w-auto px-4 py-2 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 flex items-center justify-center gap-1.5 cursor-pointer"
                    >
                      <Download className="w-3.5 h-3.5" />
                      <span>Export CSV Table</span>
                    </button>
                  </div>

                  <div className="overflow-x-auto border border-slate-800 rounded-2xl">
                    <table className="w-full text-left text-xs">
                      <thead className="bg-slate-950 text-slate-300 font-bold border-b border-slate-800">
                        <tr>
                          <th className="p-3">Pass ID</th>
                          <th className="p-3">Student Name</th>
                          <th className="p-3">Register No</th>
                          <th className="p-3">Dept</th>
                          <th className="p-3">Event Title</th>
                          <th className="p-3">Email</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-800/80 text-slate-300">
                        {filteredRegs.map((r) => (
                          <tr key={r.id} className="hover:bg-slate-900/50">
                            <td className="p-3 font-mono font-bold text-emerald-400">{r.id}</td>
                            <td className="p-3 font-semibold text-white">{r.name}</td>
                            <td className="p-3">{r.registerNo}</td>
                            <td className="p-3">{r.department} ({r.year})</td>
                            <td className="p-3 font-medium text-teal-300">{r.eventTitle}</td>
                            <td className="p-3">{r.email}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

            </div>
          </div>
        )}

      </div>
    </div>
  );
};
