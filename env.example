    sellerYear: '3rd Year',
    phone: '+919944556677',
    hostelBlock: 'Hostel Block B',
    image: 'https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=600&q=80',
    postedDate: '5 days ago',
    verifiedStudent: true
