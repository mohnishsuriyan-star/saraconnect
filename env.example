import React, { useState } from 'react';
import { 
  ShoppingBag, 
  Tag, 
  ExternalLink, 
  PlusCircle, 
  Search, 
  Filter, 
  Phone, 
  MessageCircle, 
  Sparkles, 
  CheckCircle2, 
  BookOpen, 
  Wrench, 
  Laptop, 
  Home, 
  Bike, 
  Trophy, 
  Share2, 
  ArrowUpRight,
  ShieldCheck,
  X
} from 'lucide-react';

export interface SecondHandItem {
  id: string;
  title: string;
  price: number;
  originalPrice?: number;
  category: 'Books & Notes' | 'Lab & Tools' | 'Electronics' | 'Hostel Essentials' | 'Vehicles' | 'Sports';
  condition: 'Brand New' | 'Like New' | 'Good' | 'Fair';
  description: string;
  sellerName: string;
  sellerDept: string;
  sellerYear: string;
  phone: string;
  hostelBlock?: string;
  image: string;
  postedDate: string;
  verifiedStudent: boolean;
}

const SAMPLE_LISTINGS: SecondHandItem[] = [
  {
    id: 'sell-1',
    title: 'Complete Engineering Graphics Kit (Mini Drafter + Board + Clips)',
    price: 450,
    originalPrice: 1200,
    category: 'Lab & Tools',
    condition: 'Like New',
    description: 'Perfect for 1st Year EG classes. Includes Mini Drafter with clamp, wooden drawing board, compass set, scale & clips. Used for only 1 semester.',
