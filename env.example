    category: 'Books & Notes',
    condition: 'Good',
    description: 'Regulation 2021 full semester 1 combo. Clean pages with highlighted important university exam questions & solved question papers.',
    sellerName: 'Priya Dharshini',
    sellerDept: 'EEE',
    sellerYear: '2nd Year',
    phone: '+919710987654',
    hostelBlock: 'Girls Hostel (Block A)',
    image: 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80',
    postedDate: '2 days ago',
    verifiedStudent: true
  },
  {
    id: 'sell-4',
    title: 'Saranathan Official Cotton Lab Coat (Size L)',
    price: 200,
    originalPrice: 450,
    category: 'Lab & Tools',
    condition: 'Like New',
    description: 'Stitched 100% thick white cotton lab coat with SCE logo badge. Washed and sanitized. Mandatory for Chemistry & Workshop practicals.',
    sellerName: 'Mohnish S.',
    sellerDept: 'AI & DS',
    sellerYear: '2nd Year',
    phone: '+919600112233',
    hostelBlock: 'Hostel Block C',
    image: 'https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?auto=format&fit=crop&w=600&q=80',
    postedDate: '3 days ago',
    verifiedStudent: true
  },
  {
    id: 'sell-5',
    title: 'Hercules Gear Cycle (Perfect for Campus Commute)',
    price: 1800,
    originalPrice: 4500,
    category: 'Vehicles',
    condition: 'Good',
    description: 'Sturdy 21-speed mountain bike with front basket and rear lock. Ideal for travelling between Hostel Block and Main Academic Block.',
    sellerName: 'Venkatesh R.',
    sellerDept: 'MECH',
    sellerYear: '4th Year',
    phone: '+919812345678',
    hostelBlock: 'Hostel Block A',
    image: 'https://images.unsplash.com/photo-1485965120184-e220f721d03e?auto=format&fit=crop&w=600&q=80',
